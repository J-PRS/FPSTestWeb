{
	// anabatic.gg — static client on Workers Static Assets (free, unmetered;
	// asset hits never invoke Worker code — there is no `main` by design).
	"name": "anabatic",
	"compatibility_date": "2026-11-16",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
	},
	"routes": [
		{ "pattern": "anabatic.gg", "custom_domain": true },
		{ "pattern": "www.anabatic.gg", "custom_domain": true },
	],
}
