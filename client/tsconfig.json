{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    // P2P host reuses server_bun modules, which import each other with
    // explicit .ts suffixes (Bun-style). Bundler resolution + noEmit make
    // this legal here.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "../shared"]
}
