{
  "name": "client-three-fps",
  "version": "0.1.206",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:noreload": "vite --mode noreload",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "node ../utils/_rootcheck.mjs && tsc --noEmit -p tsconfig.json && oxlint src && vitest run",
    "lint:audit": "node ../_tools/lintaudit.mjs",
    "audit:dup": "cd .. && npx -y jscpd@4 client/src server_bun/src shared --min-lines 20 --min-tokens 60 --reporters console",
    "audit:types": "type-coverage --detail",
    "audit:bundle": "npm run build && node ../_tools/bundleSize.cjs",
    "audit:mutate": "cd .. && client/node_modules/.bin/stryker run client/stryker.config.mjs"
  },
  "dependencies": {
    "@three.ez/instanced-mesh": "^0.3.16",
    "idb": "^8.0.3",
    "manifold-3d": "^3.5.4",
    "mp4-muxer": "^5.2.2",
    "postprocessing": "^6.39.5",
    "sam-js": "^0.3.1",
    "stats.js": "^0.17.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.15",
    "three.quarks": "^0.17.1",
    "xatlas-three": "^0.2.1",
    "xatlasjs": "^0.2.0"
  },
  "overrides": {
    "type-coverage-core": {
      "typescript": "npm:@typescript/typescript6@^6"
    }
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.4",
    "eslint-plugin-sonarjs": "^4.1.0",
    "knip": "^6.25.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^7.0.2003",
    "quarks.core": "^0.17.1",
    "spectorjs": "^0.9.33",
    "type-coverage": "^2.30.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "^5.0.2"
  }
}
