{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "max-lines": [
      "warn",
      {
        "max": 1000,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 120,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": [
      "warn",
      {
        "max": 15
      }
    ],
    "max-depth": [
      "warn",
      {
        "max": 4
      }
    ],
    "max-params": [
      "warn",
      {
        "max": 6
      }
    ],
    "no-console": "warn",
    "eqeqeq": ["warn", "smart"],
    "prefer-const": "warn",
    "prefer-template": "warn",
    "prefer-object-spread": "off",
    "prefer-exponentiation-operator": "warn",
    "prefer-arrow-callback": "warn",
    "prefer-spread": "warn",
    "no-lonely-if": "warn",
    "no-unneeded-ternary": "warn",
    "no-useless-catch": "warn",
    "consistent-return": "warn",
    "default-case": "warn",
    "no-multi-assign": "warn",
    "curly": "warn",
    "no-nested-ternary": "warn",
    "no-implicit-coercion": "warn",
    "no-param-reassign": "warn",
    "unicorn/prefer-dom-node-append": "warn",
    "unicorn/prefer-modern-math-apis": "warn",
    "unicorn/prefer-string-slice": "warn",
    "no-void": "warn",
    "no-plusplus": "warn",
    "no-duplicate-imports": "warn",
    "prefer-destructuring": "warn",
    "no-use-before-define": "warn",
    "no-empty-function": "warn",
    "init-declarations": "warn",
    "new-cap": "warn",
    "class-methods-use-this": ["warn", { "exceptMethods": ["getVolume", "freeInput"] }],
    "typescript/consistent-type-imports": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-inferrable-types": "warn",
    "typescript/explicit-function-return-type": "warn",
    "typescript/explicit-module-boundary-types": "warn",
    "unicorn/no-zero-fractions": "warn",
    "unicorn/numeric-separators-style": "warn",
    "unicorn/number-literal-case": "warn",
    "unicorn/explicit-length-check": "warn",
    "unicorn/catch-error-name": "warn",
    "unicorn/switch-case-braces": "warn",
    "unicorn/no-negated-condition": "warn",
    "unicorn/prefer-math-trunc": "warn",
    "unicorn/prefer-number-properties": "warn",
    "unicorn/prefer-query-selector": "off",
    "unicorn/consistent-existence-index-check": "warn",
    "oxc/no-rest-spread-properties": "warn",
    "oxc/no-async-await": "warn",
    "oxc/no-accumulating-spread": "warn",
    "oxc/no-barrel-file": "warn",
    "oxc/no-const-enum": "warn",
    "oxc/only-used-in-recursion": "warn",
    "import/no-cycle": "warn",
    "import/no-self-import": "warn",
    "import/no-duplicates": "warn",
    "import/first": "warn",
    "promise/always-return": "warn",
    "promise/catch-or-return": "warn",
    "promise/no-nesting": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/ban-ts-comment": "warn",
    "typescript/no-confusing-non-null-assertion": "warn",
    "typescript/prefer-for-of": "warn",
    "typescript/no-array-constructor": "warn",
    "typescript/no-namespace": "warn",
    "typescript/no-empty-object-type": "warn",
    "no-warning-comments": "warn",
    "no-else-return": "warn",
    "no-prototype-builtins": "warn",
    "no-restricted-globals": ["warn", "event", "name", "length", "top", "location"],
    "guard-for-in": "warn",
    "no-new": "warn",
    "no-new-func": "warn",
    "no-throw-literal": "warn",
    "prefer-promise-reject-errors": "warn",
    "no-return-assign": "warn",
    "no-sequences": "warn",
    "no-cond-assign": "warn",
    "no-unreachable-loop": "warn",
    "no-useless-assignment": "warn",
    "no-self-compare": "warn",
    "no-template-curly-in-string": "warn",
    "vitest/no-conditional-in-test": "warn",
    "vitest/expect-expect": "warn",
    "vitest/no-conditional-expect": "warn",
    "vitest/require-to-throw-message": "warn",
    "vitest/require-mock-type-parameters": "off",
    "vitest/valid-title": "warn",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": [
        "client/src/core/Logger.ts",
        "client/src/aodump.ts",
        "client/src/gunlab.ts",
        "client/src/sfxdump.ts",
        "client/src/utils/profiling.ts",
        "client/src/effects/vertexAO.ts",
        "client/src/__tests__/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "**/*.old",
    "_tools",
    "_reports"
  ]
}