{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "max-lines": [
      "warn",
      {
        "max": 1000,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 120,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": [
      "warn",
      {
        "max": 15
      }
    ],
    "max-depth": [
      "warn",
      {
        "max": 4
      }
    ],
    "max-params": [
      "warn",
      {
        "max": 6
      }
    ],
    "no-console": "warn",
    "eqeqeq": ["warn", "smart"],
    "prefer-const": "warn",
    "prefer-template": "warn",
    "prefer-object-spread": "warn",
    "prefer-exponentiation-operator": "warn",
    "prefer-arrow-callback": "warn",
    "prefer-spread": "warn",
    "no-lonely-if": "warn",
    "no-unneeded-ternary": "warn",
    "no-useless-catch": "warn",
    "consistent-return": "warn",
    "default-case": "warn",
    "no-multi-assign": "warn",
    "curly": "warn",
    "no-nested-ternary": "warn",
    "no-implicit-coercion": "warn",
    "no-param-reassign": "warn",
    "unicorn/prefer-dom-node-append": "warn",
    "unicorn/prefer-modern-math-apis": "warn",
    "unicorn/prefer-string-slice": "warn",
    "no-void": "warn",
    "no-plusplus": "warn",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off"
  },
  "overrides": [
    {
      "files": [
        "client/src/core/Logger.ts",
        "client/src/aodump.ts",
        "client/src/gunlab.ts",
        "client/src/sfxdump.ts",
        "client/src/utils/profiling.ts",
        "client/src/effects/vertexAO.ts",
        "client/src/__tests__/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "**/*.old",
    "_tools",
    "_reports"
  ]
}