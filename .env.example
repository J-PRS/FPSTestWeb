# Copy to .env (gitignored) and fill in. All optional.
# Server port (default 8000)
# FPS_PORT=8000
# Demo capture dir (authoritative half of the dual-demo desync oracle)
# FPS_DEMO=C:\TEMP\_WEB\FPSWebTest\demos_out\server
# Admin token for fleet/report endpoints
# FPS_ADMIN_TOKEN=devdemo
# Receipt signing secret (null = unsigned)
# KRIBES_SIGN_KEY=
# Fleet worker count (default: cpus-1, clamped 1..16)
# FPS_FLEET_WORKERS=4
